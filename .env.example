# Only needed for `--model openwebui:<model-name>` (e.g. `openwebui:gpt-oss:120b`).
# Plain Ollama model names (e.g. qwen3:8b, the default) never read these and
# keep working against your local Ollama server without any of this set.
#
# Base URL of your OpenWebUI instance's OpenAI-compatible API. Include
# whatever path prefix your instance actually serves that under (commonly
# `/api` or `/api/v1`) - verify with a quick curl against
# `<OPENWEBUI_BASE_URL>/models` before relying on it.
OPENWEBUI_BASE_URL=http://your-openwebui-host:3000/api
# Settings -> Account -> API Keys in OpenWebUI.
OPENWEBUI_API_KEY=sk-...
